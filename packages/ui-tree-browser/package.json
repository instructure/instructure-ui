{
  "name": "@instructure/ui-tree-browser",
  "version": "11.7.8",
  "type": "module",
  "description": "A component for displaying a hierarchical view of information",
  "author": "Instructure, Inc. Engineering and Product Design",
  "module": "./es/index.js",
  "types": "./types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/instructure/instructure-ui.git"
  },
  "homepage": "https://instructure.github.io/instructure-ui/",
  "bugs": "https://github.com/instructure/instructure-ui/issues",
  "scripts": {
    "lint": "ui-scripts lint",
    "lint:fix": "ui-scripts lint --fix",
    "clean": "ui-scripts clean",
    "build": "ui-scripts build",
    "build:watch": "pnpm run ts:check -- --watch & ui-scripts build --watch",
    "build:types": "tsc -p tsconfig.build.json",
    "ts:check": "tsc -p tsconfig.build.json --noEmit --emitDeclarationOnly false"
  },
  "license": "MIT",
  "dependencies": {
    "@instructure/emotion": "workspace:*",
    "@instructure/shared-types": "workspace:*",
    "@instructure/ui-icons": "workspace:*",
    "@instructure/ui-img": "workspace:*",
    "@instructure/ui-react-utils": "workspace:*",
    "@instructure/ui-themes": "workspace:*",
    "@instructure/ui-utils": "workspace:*",
    "@swc/helpers": "^0.5.23",
    "keycode": "^2"
  },
  "devDependencies": {
    "@instructure/ui-axe-check": "workspace:*",
    "@instructure/ui-color-utils": "workspace:*",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18 <=19"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    "./es/*": "./es/*",
    "./types/*": "./types/*",
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    ".": {
      "src": "./src/exports/a.ts",
      "types": "./types/exports/a.d.ts",
      "import": "./es/exports/a.js",
      "default": "./es/exports/a.js"
    },
    "./v11_6": {
      "src": "./src/exports/a.ts",
      "types": "./types/exports/a.d.ts",
      "import": "./es/exports/a.js",
      "default": "./es/exports/a.js"
    },
    "./v11_7": {
      "src": "./src/exports/b.ts",
      "types": "./types/exports/b.d.ts",
      "import": "./es/exports/b.js",
      "default": "./es/exports/b.js"
    },
    "./latest": {
      "src": "./src/exports/b.ts",
      "types": "./types/exports/b.d.ts",
      "import": "./es/exports/b.js",
      "default": "./es/exports/b.js"
    }
  }
}
